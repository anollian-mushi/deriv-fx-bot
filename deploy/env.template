# /opt/fxbot/shared/.env  (only root and the fxbot user can read it; never share it)
# Fill in the four secrets, save, then: sudo systemctl restart fxbot

# Deriv (Personal Access Token with the "trade" scope, and your app id)
DERIV_APP_ID=
DERIV_PAT=
DERIV_ACCOUNT_ID=
DERIV_MODE=demo

# Telegram (same bot and chat id as the incubator alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true = place demo orders; false = dry run (quotes and signals only)
TRADING_ENABLED=true

# Which incubator candidate to run: "leader" = top active candidate on the leaderboard
# (checked at each start), or a candidate id such as f3_trend_pullback_4h_r5
STRATEGY_ID=leader
LEADER_FALLBACK=f1_london_breakout_r5

# Pretend ledger on demo (50-100 USD); stake = 3% of it
BOT_START_BALANCE=100

# Journal every quote's commission rate once an hour (true/false)
COST_SAMPLING=true

# Real money needs DERIV_MODE=real, a GRADUATED candidate AND this set to yes. Leave empty.
CONFIRM_REAL=
