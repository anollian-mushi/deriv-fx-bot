# Copy this to .env on the VPS and fill in real values.
# In cloud sessions these are set as environment variables instead.

# Deriv
DERIV_APP_ID=
DERIV_PAT=
DERIV_ACCOUNT_ID=
DERIV_MODE=demo

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety switch: the bot only places orders when this is true
TRADING_ENABLED=false
