# Copy this to .env on the VPS and fill in real values.
# In cloud sessions these are set as environment variables instead.

# Deriv
DERIV_APP_ID=
DERIV_PAT=
DERIV_ACCOUNT_ID=
DERIV_MODE=demo

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety switch: the bot only places orders when this is true
TRADING_ENABLED=false

# Live bot (src/fxbot/live, deploy/DEPLOY.md)
# Incubator candidate id, or "leader" (top active candidate on the incubator leaderboard)
STRATEGY_ID=leader
LEADER_FALLBACK=f1_london_breakout_r5
# Pretend ledger on demo, 50-100 USD (stake = 3% of it)
BOT_START_BALANCE=100
# Quote every pair once an hour and journal the commission rate
COST_SAMPLING=true
# Real money also needs DERIV_MODE=real and a GRADUATED candidate. Leave empty.
CONFIRM_REAL=
# Where the journal, heartbeat and HALT file live (default state/live)
# BOT_HOME=
